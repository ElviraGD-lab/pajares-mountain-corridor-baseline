        "LANDSAT_SCALE = 2.75e-05\n",
        "LANDSAT_OFFSET = -0.2\n",
        "\n",
        "\n",
        "def landsat_composite(year, bbox, aoi_geom, crs=CRS, resolution=RESOLUTION):\n",
        "    \"\"\"Build an annual Landsat 8 median composite for one year.\n",
        "\n",
        "    Returns surface reflectance clipped to the AOI. Visualisation is left\n",
        "    to the caller so that both years can share one stretch.\n",
        "    \"\"\"\n",
        "    items = catalog.search(\n",
        "        collections=[COLLECTION],\n",
        "        bbox=bbox,\n",
        "        datetime=f'{year}-01-01/{year}-12-31',\n",
        "        query={\n",
        "            'platform': {'eq': PLATFORM},\n",
        "            'eo:cloud_cover': {'lt': MAX_CLOUD},\n",
        "            'landsat:collection_category': {'eq': 'T1'},\n",
        "        },\n",
        "    ).item_collection()\n",
        "\n",
        "    if len(items) == 0:\n",
        "        raise ValueError(f'No Tier 1 scenes found for {year}.')\n",
        "\n",
        "    ds = load(\n",
        "        items,\n",
        "        bands=['red', 'green', 'blue'],\n",
        "        bbox=bbox,\n",
        "        resolution=resolution,\n",
        "        crs=crs,\n",
        "        chunks={'x': 1024, 'y': 1024},\n",
        "        groupby='solar_day',\n",
        "        patch_url=pc.sign,\n",
        "    )\n",
        "    print(f'{year}: {len(items)} scenes -> {ds.sizes[\"time\"]} solar days')\n",
        "    print(f'{year}: grid {ds.sizes[\"y\"]} x {ds.sizes[\"x\"]} px')\n",
        "\n",
        "    # A new name at every step. `ds` is never overwritten, so the scale and\n",
        "    # offset cannot be applied twice by re-running this cell.\n",
        "    # Landsat Collection 2 Level-2 surface reflectance:\n",
        "    #   reflectance = DN * 0.0000275 - 0.2      (NOT the Sentinel-2 values)\n",
        "    masked = ds.where(ds != 0)\n",
        "    reflectance = masked * LANDSAT_SCALE + LANDSAT_OFFSET\n",
        "\n",
        "    composite = reflectance.median(dim='time').compute()\n",
        "\n",
        "    composite_da = composite.to_array('band')\n",
        "    aoi_in_crs = gpd.GeoSeries([aoi_geom], crs='EPSG:4326').to_crs(crs)\n",
        "    clipped = composite_da.rio.clip(aoi_in_crs)\n",
        "\n",
        "    return clipped"
