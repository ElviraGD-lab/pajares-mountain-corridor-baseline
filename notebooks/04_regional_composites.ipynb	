        "def scene_inventory(year, bbox, max_cloud=MAX_CLOUD, tier=None):\n",
        "    \"\"\"Return metadata for Landsat 8 scenes over the AOI in one year.\n",
        "\n",
        "    tier=None includes both quality tiers; tier='T1' keeps only scenes that\n",
        "    passed geometric validation (RMSE < 12 m), which USGS requires for\n",
        "    time-series analysis.\n",
        "    \"\"\"\n",
        "    query = {\n",
        "        'platform': {'eq': PLATFORM},\n",
        "        'eo:cloud_cover': {'lt': max_cloud},\n",
