# Environments
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# Data lives on Google Drive and is regenerated by the notebooks.
# Source passports in data/ record where each dataset came from.
data/*
!data/README.md
!data/**/README.md

# Large rasters never go into git: GitHub rejects files over 100 MB,
# and the Asturias composites are 190 MB each.
*.tif
*.tiff
*.gpkg
*.parquet
*.nc

# Small derived results are useful to read in the browser and are kept.
!*.csv
!*.geojson
